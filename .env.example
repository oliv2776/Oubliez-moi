# ============================================================================
#  Oubliez-moi – configuration. Copiez ce fichier en .env et adaptez-le.
#  Après modification : docker compose up -d
# ============================================================================

# --- Accès à l'interface ----------------------------------------------------
# Adresse d'écoute sur le serveur :
#   127.0.0.1 : uniquement depuis le serveur (tunnel SSH ou reverse proxy)
#   0.0.0.0   : depuis le réseau local (ex. http://10.10.1.10:27480)
#   ou l'IP d'une interface précise (ex. 10.10.1.10, ou l'IP Tailscale/WireGuard)
BIND_ADDRESS=127.0.0.1
PORT=27480
ADMIN_USER=admin
# Choisissez un mot de passe long (ex. : openssl rand -base64 24)
ADMIN_PASSWORD=
# Mettez true si l'interface est servie en HTTPS (recommandé)
COOKIE_SECURE=false
TZ=Europe/Paris
# IP/CIDR exact du reverse proxy tel qu'il est vu depuis le conteneur. Un proxy sur l'hôte
# arrive par la passerelle du réseau Docker, pas par 127.0.0.1 :
#   docker inspect oubliez-moi --format '{{range .NetworkSettings.Networks}}{{.Gateway}}{{end}}'
# Sinon, tous les visiteurs partagent la même IP pour la limitation des connexions.
# Ne mettez jamais * : cela permettrait à n'importe quel client de falsifier
# X-Forwarded-For / X-Forwarded-Proto. Exemple : 172.20.0.1 ou 172.20.0.0/16.
# Sans reverse proxy local, gardez la valeur sûre par défaut.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Messagerie ---------------------------------------------------------------
# L'adresse e-mail, les serveurs SMTP/IMAP, le mode simulation et le débit se
# configurent dans l'interface web (page Réglages). Les variables ci-dessous sont
# facultatives : elles servent de valeurs par défaut tant que rien n'a été saisi
# dans l'interface (pratique pour une installation automatisée).
#
# DRY_RUN=true
# SEND_PER_HOUR=30
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls | ssl | none
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_BCC_SELF=false
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_SECURITY=ssl             # ssl | starttls | none
# IMAP_USER=                    # vide = identifiant SMTP
# IMAP_PASSWORD=                # vide = mot de passe SMTP
# IMAP_FOLDERS=INBOX
# IMAP_POLL_MINUTES=10
# IMAP_AUTHSERV_ID=mx.google.com  # identifiant de votre serveur dans Authentication-Results.
# Plus simple : Réglages › Relève des réponses › « Enregistrer et détecter automatiquement ».
# Sans cette valeur, les réponses ne sont jamais considérées authentifiées pour les
# clôtures automatiques (Gmail : mx.google.com ; Outlook/Hotmail n'en fournissent pas).

# Boîtes Hotmail / Outlook.com (page Boîtes mail) : identifiant d'application Microsoft.
# Inutile en temps normal : celui du projet est utilisé. À renseigner seulement pour
# utiliser votre propre application déclarée dans Microsoft Entra.
# MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Classer automatiquement les réponses (supprimé / aucune donnée / identité demandée…)
AUTO_CLASSIFY=true

# --- Automatismes, rangement, IA, notifications --------------------------------
# Tout se règle dans l'interface (Réglages). Valeurs par défaut facultatives :
# AUTO_REPLIES=true             # réponses automatiques (pièce d'identité, intérêt légitime, pays)
# AUTO_FORMAL_NOTICE=true       # mise en demeure après la relance
# FORMAL_NOTICE_WAIT_DAYS=15
# AUTO_CONFIRM_LINKS=true       # ouvrir les liens « confirmez votre demande » (domaine du courtier uniquement)
# AUTO_SUPPLEMENTS=true
# RESIDENCE_COUNTRY=France
# IMAP_FILE_MODE=off            # off | move | label (Gmail)
# IMAP_FILE_FOLDER=Oubliez-moi
# IMAP_MARK_READ=false
# LLM_URL=http://ollama:11434
# LLM_MODEL=tev1:4b                # tev1:4b, nimble, tev1:0.8b, qwen2.5:3b, qwen2.5:7b, qwen3:4b…
# LLM_MODE=decision               # decision (Tev1, Nimble) ou chat (Qwen…) ; déduit automatiquement pour les modèles connus
# APP_URL=http://10.10.1.10:27480
# NOTIFY_NTFY_URL=https://ntfy.sh/mon-sujet-secret
# NOTIFY_GOTIFY_URL=
# NOTIFY_EMAIL_DIGEST=false

# --- Délais et automatisations ------------------------------------------------
# Délai légal de réponse (RGPD art. 12.3 : un mois)
RESPONSE_DAYS=30
# Relance automatique à l'expiration du délai, puis attente avant « sans réponse »
AUTO_REMINDER=true
REMINDER_WAIT_DAYS=15
# Renvoyer une demande N jours après confirmation (les courtiers recollectent). 0 = jamais
RESEND_INTERVAL_DAYS=90
# Nombre maximal de cycles automatiques par courtier et profil (cycle initial compris).
MAX_AUTOMATIC_RESEND_CYCLES=3
# Ajouter automatiquement les nouveaux courtiers du catalogue aux campagnes en cours
AUTO_ENROLL_NEW_BROKERS=true

# --- Catalogue de courtiers ---------------------------------------------------
# Pays dont les courtiers sont activés par défaut (all = courtiers internationaux)
# Ex. : fr,be,all  ou  fr,de,at,ch,gb,all
BROKER_COUNTRIES=fr,all
# Mise à jour automatique depuis Datenanfragen.de tous les N jours. 0 = manuelle
BROKER_AUTO_UPDATE_DAYS=30

# --- Sécurité et sauvegardes ---------------------------------------------------
# Clé de chiffrement des mots de passe stockés (et des sauvegardes). Recommandé :
# générez-la une fois (openssl rand -base64 32) et gardez-en une copie ailleurs.
# Vide : une clé est générée automatiquement dans le volume de données.
ENCRYPTION_KEY=
# Dossier de votre pool où écrire les sauvegardes (sur le serveur hôte), accessible
# à l'utilisateur du conteneur : sudo mkdir -p /mnt/tank/backups/oubliez-moi && sudo chown 10001 /mnt/tank/backups/oubliez-moi
BACKUP_PATH=./backups
# Fréquence (daily | weekly | off), nombre de sauvegardes gardées, chiffrement :
# modifiables aussi dans Réglages → Sécurité et sauvegardes.
# BACKUP_SCHEDULE=daily
# BACKUP_KEEP=14
# BACKUP_ENCRYPT=true

# --- Avancé -----------------------------------------------------------------
# Pays utilisé pour interpréter les numéros de téléphone saisis sans indicatif
# (06 12 34 56 78 -> +33 6 12 34 56 78). Code ISO à 2 lettres : FR, BE, CH…
PHONE_REGION=FR
# Préfixe des références insérées dans les objets des e-mails
REFERENCE_PREFIX=OUBLI
# Clé de session : générée et conservée automatiquement dans le volume si vide
SECRET_KEY=
